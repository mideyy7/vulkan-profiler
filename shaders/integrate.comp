#version 450

layout(local_size_x = 64) in;

struct Particle {
    vec4 pos_mass;   // xyz = position, w = mass
    vec4 vel_pad;    // xyz = velocity, w = unused
};

layout(std430, set = 0, binding = 0) buffer Particles {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) readonly buffer Accelerations {
    vec4 accelerations[];
};

layout(push_constant) uniform PushConstants {
    uint count;
    float G;
    float softening;
    float dt;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;

    vec3 vel = particles[i].vel_pad.xyz;
    vec3 acc = accelerations[i].xyz;

    // Semi-implicit Euler: update velocity first, then position.
    vel += acc * dt;
    particles[i].vel_pad = vec4(vel, 0.0);

    vec3 pos = particles[i].pos_mass.xyz;
    float mass = particles[i].pos_mass.w;
    pos += vel * dt;
    particles[i].pos_mass = vec4(pos, mass);
}
